APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate at least 32 random bytes. Never commit the real key.
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters

TIKTOK_SCRAPER_BASE_URL=https://hof.talesapi.workers.dev
TIKTOK_SCRAPER_API_KEY=

RATE_LIMIT_ENABLED=true
LOG_LEVEL=debug

# Mother scraper routes confirmed: profile metadata and creator post list.
TIKTOK_PROFILE_PATH=/api/profile
TIKTOK_POSTS_PATH=/api/profile/posts
TIKTOK_BATCH_PROFILE_PATH=
TIKTOK_SYNC_BATCH_SIZE=10
TIKTOK_SYNC_ENABLED=false

# Backblaze B2 private bucket credentials (Cloudflare Worker secrets).
B2_ACCOUNT_ID=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
# Comma-separated exact frontend origins; set after the frontend domain is known.
CORS_ORIGINS=
