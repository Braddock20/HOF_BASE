# Local-only reference. Put real values in .dev.vars (gitignored) or Cloudflare secrets.
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Existing, separately deployed TikTok scraper Worker
TIKTOK_SCRAPER_BASE_URL=https://hof.talesapi.workers.dev
TIKTOK_PROFILE_PATH=/api/profile
TIKTOK_POSTS_PATH=/api/profile/posts
TIKTOK_BATCH_PROFILE_PATH=
TIKTOK_SYNC_BATCH_SIZE=10
TIKTOK_SYNC_ENABLED=false

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
CORS_ORIGINS=https://your-hof-frontend.example

# Backblaze B2 credentials are secrets, not plain vars
B2_ACCOUNT_ID=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
